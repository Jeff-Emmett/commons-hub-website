  {
    "date_created": "2025-09-25T10:18:13.755Z",
    "date_updated": "2025-09-25T11:49:59.519Z",
    "id": "12",
    "name_not_used": "CULTURE",
    "status": "published",
    "user_created": "258593a6-4999-4401-8ea6-5959100f1278",
    "user_updated": "258593a6-4999-4401-8ea6-5959100f1278",
    "accordion_items": [
      {
        "accordion_id": "12",
        "content": "<p style=\"text-align: left\">Aj keď je jeho cisárska minulosť dávno preč, Reichenau an der Rax zostáva kultúrnym centrom s dvoma hudobnými pavilónmi a klasickým divadlom. Jeho šesťtýždňový letný festival ponúka dva denné predstavenia, spolu s čítaniami literatúry, klasickou hudbou a ďalšími umeleckými podujatiami. Ďalšie pozostatky monarchie sú rôzne cisárske zámky, sídla a vily, ktoré prispievajú k šľachetnému vzhľadu mesta.</p>",
        "date_created": "2025-09-25T10:25:16.313Z",
        "date_updated": "2025-09-25T11:49:58.019Z",
