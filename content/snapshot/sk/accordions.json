    "accordion_items": [
      {
        "accordion_id": "11",
        "content": "<p style=\"text-align: left\">Početné pláže pozdĺž rieky Schwarza pozývajú na kúpanie a opaľovanie v pešej vzdialenosti od Hub</p>",
