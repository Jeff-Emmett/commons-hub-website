    "user_updated": "258593a6-4999-4401-8ea6-5959100f1278",
    "accordion_items": [
      {
        "accordion_id": "13",
        "content": "<p style=\"text-align: left\">The <strong>commons hub</strong> garden thrives with raised beds, fruit trees, and a buzzing beehive, creating a vibrant permaculture space. Join us to care for, maintain and expand it, and enjoy its fruits with us!</p>",
