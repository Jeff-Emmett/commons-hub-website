    "accordion_items": [
      {
        "accordion_id": "5",
        "content": "<p style=\"text-align: left\">Regen Network, built to promote ecological sustainability and regenerative agriculture, is an innovative platform we proudly support by operating a validator node.</p><p style=\"text-align: left\">A commission rate of 10% allows us to maintain a reliable and resilient technical setup. <strong>Stake your $REGEN </strong>with us to contribute to the network's mission of sustainability and regeneration.</p><p style=\"text-align: left\"><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-blue-600 underline button\" href=\"https://wallet.keplr.app/chains/regen?modal=validator&amp;chain=regen-1&amp;validator_address=regenvaloper1aymx97z6eanltjg8cwarf6hrmasmnvquhzdcr4\">Stake with us</a></p>",
        "date_created": "2025-07-01T11:57:27.669Z",
        "date_updated": null,
        "header": "REGEN",
        "id": "10",
        "main_image": null,
        "sort": "2",
        "user_created": "67202695-054e-48ad-8402-56f3a03c38c5",
        "user_updated": null
      },
      {
        "accordion_id": "5",
        "content": "<p style=\"text-align: left\">Cosmos, known as the 'internet of blockchains', is designed to facilitate interoperability among various blockchain systems. To support this innovative project, we operate a validator node on the Cosmos chain.</p><p style=\"text-align: left\">A commission rate of 10% allows us to maintain a reliable and resilient technical setup. <strong>Stake your $ATOM with us</strong> to contribute to the network's security and growth.</p><p style=\"text-align: left\"><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-blue-600 underline button\" href=\"https://wallet.keplr.app/chains/cosmos-hub?modal=validator&amp;chain=cosmoshub-4&amp;validator_address=cosmosvaloper1ehlmvdvgkpfcx8f07l929udjerc9mtyhl07ynp\">Stake with us</a></p>",
        "date_created": "2025-07-01T11:56:53.666Z",
        "date_updated": null,
        "header": "COSMOS",
        "id": "9",
