  {
    "date_created": "2025-09-25T10:18:13.755Z",
    "date_updated": "2025-09-25T11:49:59.519Z",
    "id": "12",
    "name_not_used": "CULTURE",
    "status": "published",
    "user_created": "258593a6-4999-4401-8ea6-5959100f1278",
    "user_updated": "258593a6-4999-4401-8ea6-5959100f1278",
    "accordion_items": [
      {
        "accordion_id": "12",
        "content": "<p style=\"text-align: left\">Bár császári múltja már rég eltűnt, Reichenau an der Rax továbbra is kulturális központ marad két zenei pavilonnal és egy klasszikus színházzal. Hathetes nyári fesztiválja naponta két előadást kínál, valamint irodalmi felolvasásokat, klasszikus zenét és egyéb művészi eseményeket. A monarchia további maradványai különféle császári kastélyok, kúriák és villák, amelyek a város nemes megjelenéséért felelnek.</p>",
        "date_created": "2025-09-25T10:25:16.313Z",
        "date_updated": "2025-09-25T11:49:58.019Z",
        "header": "THEATER FESTIVAL",
