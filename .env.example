# commons-hub-website — environment template. Copy to .env.local (gitignored).
# Never commit real values. Secrets live in Infisical; NEXT_PUBLIC_* values ship
# to the browser and must be domain-restricted at their provider, not "hidden".

# --- Directus CMS ---
NEXT_PUBLIC_DIRECTUS_URL=https://admin.commons-hub.at
DIRECTUS_URL=https://admin.commons-hub.at

# --- Google Maps Embed API (browser-visible by design) ---
# This key is embedded in the map iframe and is therefore PUBLIC. Do not rely on
# hiding it — restrict it in Google Cloud Console instead:
#   Application restriction: HTTP referrers -> commons-hub.at/*, *.commons-hub.at/*
#   API restriction:         Maps Embed API only
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Supabase (anon key is public/browser-safe; RLS enforces access) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Instagram ---
NEXT_PUBLIC_INSTAGRAM_PINNED_URL=

# --- Listmonk (newsletter / booking mail) — server-side secrets ---
LISTMONK_URL=
LISTMONK_TOKEN=
LISTMONK_LIST_ID=
LISTMONK_MESSENGER=
LISTMONK_TEMPLATE_ID=
LISTMONK_BOOKING_TEMPLATE_ID=
LISTMONK_OFFICE_EMAIL=

# --- Outbound SMTP — server-side secrets ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
MAIL_TO_OFFICE=

# --- Misc ---
ARTIZEN_STATS_URL=
USE_STATIC_CONTENT=
